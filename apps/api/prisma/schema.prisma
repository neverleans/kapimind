// Prisma schema — Plataforma de Investimentos
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// USERS
// =============================================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  telegramChatId  String?
  riskProfile     RiskProfile @default(BALANCED)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  portfolios      Portfolio[]
  bookProgress    BookProgress[]
  alerts          Alert[]
  recommendations Recommendation[]
}

enum RiskProfile {
  CONSERVATIVE
  BALANCED
  AGGRESSIVE
}

// =============================================================================
// PORTFOLIO
// =============================================================================

model Portfolio {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  broker    String   // "Inter", "XP", "BTG", etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holdings     Holding[]
  transactions Transaction[]

  @@index([userId])
}

model Holding {
  id            String    @id @default(cuid())
  portfolioId   String
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker        String
  type          AssetType
  quantity      Decimal   @db.Decimal(18, 6)
  avgPrice      Decimal   @db.Decimal(18, 4)
  // Campos derivados (atualizados por worker brapi-sync)
  lastPrice     Decimal?  @db.Decimal(18, 4)
  lastDividend  Decimal?  @db.Decimal(18, 6)
  dividendYield Decimal?  @db.Decimal(8, 4)
  pvp           Decimal?  @db.Decimal(8, 4)
  marketValue   Decimal?  @db.Decimal(18, 2)
  updatedAt     DateTime?

  @@unique([portfolioId, ticker])
  @@index([ticker])
  @@index([type])
}

enum AssetType {
  STOCK
  FII
  FIAGRO
  ETF
  CRYPTO
  BOND
}

model Transaction {
  id          String   @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker      String
  type        TxType
  quantity    Decimal  @db.Decimal(18, 6)
  price       Decimal  @db.Decimal(18, 4)
  total       Decimal  @db.Decimal(18, 2)
  fees        Decimal  @default(0) @db.Decimal(18, 2)
  occurredAt  DateTime
  notes       String?
  createdAt   DateTime @default(now())

  @@index([portfolioId, occurredAt])
  @@index([ticker, occurredAt])
}

enum TxType {
  BUY
  SELL
  DIVIDEND
  JCP
  AMORTIZATION
  SPLIT
}

// =============================================================================
// ALERTS & RECOMMENDATIONS
// =============================================================================

model Alert {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source          AlertSource
  ticker          String?
  kind            String        // "rsi_oversold" | "dividend_paid" | "yield_spike" | "stop_hit"
  payload         Json
  status          AlertStatus   @default(NEW)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  recommendation Recommendation?

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([ticker])
}

enum AlertSource {
  TRADINGVIEW
  BRAPI
  INTERNAL
  MACRO
}

enum AlertStatus {
  NEW
  REVIEWED
  ACTED
  DISMISSED
}

model Recommendation {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertId      String?    @unique
  alert        Alert?     @relation(fields: [alertId], references: [id], onDelete: SetNull)
  action       RecoAction
  summary      String     // 1 linha PT-BR (<= 120 chars)
  reasoning    String     // 2-3 parágrafos
  confidence   Float      // 0..1
  modelVersion String     // ex: "claude-haiku-4-5-20251001"
  userFeedback Feedback?
  createdAt    DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

enum RecoAction {
  BUY
  HOLD
  SELL
  REBALANCE
  REVIEW
  NOTHING
}

enum Feedback {
  HELPFUL
  NEUTRAL
  MISLEADING
}

// =============================================================================
// ROADMAP EDUCACIONAL
// =============================================================================

model BookProgress {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookSlug  String
  lessonIdx Int
  status    LessonStatus  @default(STARTED)
  notes     String?
  updatedAt DateTime      @updatedAt

  @@unique([userId, bookSlug, lessonIdx])
  @@index([userId, bookSlug])
}

enum LessonStatus {
  STARTED
  READ
  MASTERED
}

// =============================================================================
// MACRO SNAPSHOTS
// =============================================================================

model MacroSnapshot {
  id            String   @id @default(cuid())
  ticker        String
  month         String   // "2026-01" (YYYY-MM)
  avgPrice      Decimal  @db.Decimal(18, 4)
  firstPrice    Decimal  @db.Decimal(18, 4)
  lastPrice     Decimal  @db.Decimal(18, 4)
  dividends     Decimal  @db.Decimal(18, 4)
  dividendYield Decimal  @db.Decimal(8, 4)
  daysCount     Int
  payload       Json
  createdAt     DateTime @default(now())

  @@unique([ticker, month])
  @@index([month])
  @@index([ticker])
}
