generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Kapimind — Schemas ajustados com índices para queries quentes.
//
// Padrão Prisma + PostgreSQL: indices em chaves estrangeiras e em colunas
// usadas em WHERE de queries frequentes (ticker, status, datas).
// =============================================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  telegramChatId  String?
  whatsappPhone   String?
  riskProfile     RiskProfile @default(BALANCED)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  portfolios      Portfolio[]
  bookProgress    BookProgress[]
  alerts          Alert[]
  recommendations Recommendation[]
  suitabilityLog  SuitabilityLog[]

  @@index([email])
}

enum RiskProfile {
  CONSERVATIVE
  BALANCED
  AGGRESSIVE
}

model Portfolio {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  broker    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holdings     Holding[]
  transactions Transaction[]

  @@index([userId, createdAt])
}

model Holding {
  id            String   @id @default(cuid())
  portfolioId   String
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker        String
  type          AssetType
  quantity      Decimal  @db.Decimal(18, 6)
  avgPrice      Decimal  @db.Decimal(18, 4)

  lastPrice     Decimal? @db.Decimal(18, 4)
  lastDividend  Decimal? @db.Decimal(18, 6)
  dividendYield Decimal? @db.Decimal(8, 4)
  pvp           Decimal? @db.Decimal(8, 4)
  marketValue   Decimal? @db.Decimal(18, 2)
  updatedAt     DateTime?

  @@unique([portfolioId, ticker])
  @@index([ticker])
  @@index([type])
  @@index([portfolioId, updatedAt])
}

enum AssetType {
  STOCK
  FII
  FIAGRO
  ETF
  CRYPTO
  BOND
}

model Transaction {
  id          String   @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker      String
  type        TxType
  quantity    Decimal  @db.Decimal(18, 6)
  price       Decimal  @db.Decimal(18, 4)
  total       Decimal  @db.Decimal(18, 2)
  fees        Decimal  @default(0) @db.Decimal(18, 2)
  occurredAt  DateTime
  notes       String?
  createdAt   DateTime @default(now())

  @@index([portfolioId, occurredAt])
  @@index([ticker, occurredAt])
  @@index([type])
}

enum TxType {
  BUY
  SELL
  DIVIDEND
  JCP
  AMORTIZATION
  SPLIT
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      AlertSource
  ticker      String?
  kind        String
  payload     Json
  status      AlertStatus @default(NEW)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recommendation Recommendation?

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([ticker])
  @@index([status, createdAt])
}

enum AlertSource {
  TRADINGVIEW
  BRAPI
  INTERNAL
  MACRO
}

enum AlertStatus {
  NEW
  REVIEWED
  ACTED
  DISMISSED
}

model Recommendation {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertId      String?  @unique
  alert        Alert?   @relation(fields: [alertId], references: [id], onDelete: SetNull)
  action       RecoAction
  summary      String
  reasoning    String
  confidence   Float
  modelVersion String
  userFeedback Feedback?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

enum RecoAction {
  BUY
  HOLD
  SELL
  REBALANCE
  REVIEW
  NOTHING
}

enum Feedback {
  HELPFUL
  NEUTRAL
  MISLEADING
}

model BookProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookSlug  String
  lessonIdx Int
  status    LessonStatus @default(STARTED)
  notes     String?
  updatedAt DateTime @updatedAt

  @@unique([userId, bookSlug, lessonIdx])
  @@index([userId, bookSlug])
}

enum LessonStatus {
  STARTED
  READ
  MASTERED
}

model MacroSnapshot {
  id            String   @id @default(cuid())
  ticker        String
  month         String
  avgPrice      Decimal  @db.Decimal(18, 4)
  firstPrice    Decimal  @db.Decimal(18, 4)
  lastPrice     Decimal  @db.Decimal(18, 4)
  dividends     Decimal  @db.Decimal(18, 4)
  dividendYield Decimal  @db.Decimal(8, 4)
  daysCount     Int
  payload       Json
  createdAt     DateTime @default(now())

  @@unique([ticker, month])
  @@index([month])
  @@index([ticker, month])
}

// =============================================================================
// FASE 9: Strategy + Backtest
// =============================================================================

model Strategy {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      StrategyType
  config    Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  backtests Backtest[]

  @@index([userId, enabled])
}

enum StrategyType {
  PERMANENT_PORTFOLIO
  DUAL_MOMENTUM
  RISK_PARITY
  CUSTOM
}

model Backtest {
  id                  String   @id @default(cuid())
  strategyId          String
  strategy            Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  startDate           DateTime
  endDate             DateTime
  monthlyContribution Float
  metrics             Json
  monthlyData         Json
  durationMs          Int
  executedAt          DateTime @default(now())

  @@index([strategyId, executedAt])
}

// =============================================================================
// FASE 10: Suitability CVM 30 (audit log)
// =============================================================================

model SuitabilityLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile         RiskProfile
  score           Int
  answers         Json
  recommendations Json
  prohibitedAssets Json
  flags           Json
  validUntil       DateTime
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, validUntil])
}
