{
  "name": "kapimind",
  "version": "1.0.0",
  "description": "Kapimind — Plataforma pessoal de investimentos com IA. Mind + Capital. Roadmap educacional, alertas 24/7, calculadoras, simulador, IR automático.",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf dist .next node_modules"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "prettier": "3.3.3",
    "eslint": "9.13.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
